{
  "crons": [
    {
      "path": "/api/cron/calendar-sync",
      "schedule": "0 14 * * *"
    },
    {
      "path": "/api/cron/spin-reminder",
      "schedule": "0 18 * * *"
    },
    {
      "path": "/api/cron/event-reminders?mode=morning",
      "schedule": "0 18,19 * * *"
    },
    {
      "path": "/api/cron/event-reminders?mode=hour",
      "schedule": "*/15 * * * *"
    },
    {
      "path": "/api/cron/expire-events",
      "schedule": "0 10 * * *"
    }
  ]
}
